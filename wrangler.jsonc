{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nutrition-dashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: any non-asset, non-/api path falls back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served straight from
    // ./dist (with the SPA fallback above). Keeps the Worker off the hot path
    // for static files.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Access JWT validation (see worker/access.ts). Not secrets — the
  // aud tag and team domain are identifiers, not credentials, and are safe to
  // commit. Values come from the Access app dialog ("JWKs URL" / "Audience").
  "vars": {
    "ACCESS_JWKS_URL": "https://summer-firefly-8861.cloudflareaccess.com/cdn-cgi/access/certs",
    "ACCESS_AUD": "321d94acc4b36706249c459c3ba2bd456a003e565c81bdb129e1a0973dd65b3d"
  },
  // Workers Logs: persist invocation + console logs to the Cloudflare dashboard
  // (Workers & Pages → nutrition-dashboard → Observability), queryable for ~7d.
  // head_sampling_rate: 1 = log 100% of requests (fine for low personal traffic).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

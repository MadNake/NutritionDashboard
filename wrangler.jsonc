{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nutrition-dashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: any non-asset, non-/api path falls back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served straight from
    // ./dist (with the SPA fallback above). Keeps the Worker off the hot path
    // for static files.
    "run_worker_first": ["/api/*"]
  }
}
